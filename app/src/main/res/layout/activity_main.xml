<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.alfa.launcher.CyberBackgroundView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/header"
                style="@style/Mono"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.15"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/status"
                style="@style/Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:textColor="@color/green"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/cyan_dim" />

        <!-- clock -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/clock"
                style="@style/Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:shadowColor="@color/cyan"
                android:shadowRadius="28"
                android:textSize="68sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/seconds"
                style="@style/Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:shadowColor="@color/magenta"
                android:shadowRadius="16"
                android:textColor="@color/magenta"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/date"
            style="@style/Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.2"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <!-- system stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                style="@style/Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.15"
                android:text="// SYSTEM TELEMETRY"
                android:textColor="@color/magenta"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/stats"
                style="@style/Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- terminal log -->
        <TextView
            android:id="@+id/log"
            style="@style/Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:minLines="4"
            android:textColor="@color/green"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/appsHeader"
            style="@style/Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:letterSpacing="0.15"
            android:textColor="@color/magenta"
            android:textSize="10sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical" />

        <!-- terminal input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                style="@style/Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prompt"
                android:textColor="@color/green"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="monospace"
                android:hint="@string/input_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:singleLine="true"
                android:textColor="@color/cyan"
                android:textColorHint="@color/text_dim"
                android:textCursorDrawable="@drawable/cursor"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
