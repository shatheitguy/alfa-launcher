<?xml version="1.0" encoding="utf-8"?>
<com.alfa.launcher.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= HOME ================= -->
    <FrameLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.alfa.launcher.HudBackground
            android:id="@+id/hud"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_gravity="top"
            android:background="@drawable/scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_bottom" />

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- profile: logo + greeting / name, and the OS settings button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/profileRow"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_item"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp">

                <FrameLayout
                    android:id="@+id/avatarFrame"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/avatar_ring"
                    android:padding="3dp">

                    <ImageView
                        android:id="@+id/avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greeting"
                        style="@style/Tech"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.2"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/profileName"
                        style="@style/Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

                <TextView
                    android:id="@+id/settingsButton"
                    style="@style/Label"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/glass_pill"
                    android:contentDescription="ALFA OS settings"
                    android:gravity="center"
                    android:text="⚙"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- top bar: clock + system readout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/clock"
                        style="@style/Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-thin"
                        android:includeFontPadding="false"
                        android:textSize="60sp" />

                    <TextView
                        android:id="@+id/date"
                        style="@style/Tech"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.2"
                        android:textColor="@color/text" />
                </LinearLayout>

                <TextView
                    android:id="@+id/sysInfo"
                    style="@style/Tech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:lineSpacingExtra="3dp"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/netRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/netDot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/techLine"
                    style="@style/Tech"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- update available chip -->
            <TextView
                android:id="@+id/updateChip"
                style="@style/Tech"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/glass_pill"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:textColor="@color/text"
                android:visibility="gone" />

            <!-- set-as-default banner -->
            <LinearLayout
                android:id="@+id/banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/glass"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/banner_title"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/banner_body"
                    android:textColor="@color/text_2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bannerLater"
                        style="@style/Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="10dp"
                        android:text="@string/banner_later"
                        android:textColor="@color/text_2"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/bannerSet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/pill_accent"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="18dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="9dp"
                        android:text="@string/banner_set"
                        android:textColor="#FF000000"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- orbit dial -->
            <com.alfa.launcher.OrbitView
                android:id="@+id/orbit"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1" />

            <!-- IT tools quick row -->
            <LinearLayout
                android:id="@+id/toolsRow"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal" />

            <!-- search -->
            <LinearLayout
                android:id="@+id/searchPill"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:alpha="0.7"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search" />

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/search_apps"
                    android:textColor="@color/text_2"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Tech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALL APPS ◎"
                    android:textColor="@color/text_3"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- dock -->
            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================= ALL APPS ORBIT ================= -->
    <FrameLayout
        android:id="@+id/galaxy"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.alfa.launcher.HudBackground
            android:id="@+id/galaxyHud"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/galaxyContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-light"
                    android:text="All apps"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/galaxyMode"
                    style="@style/Tech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/glass_pill"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/galaxyClose"
                    style="@style/Tech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_pill"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp"
                    android:text="CLOSE ✕" />
            </LinearLayout>

            <TextView
                android:id="@+id/galaxyCount"
                style="@style/Tech"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.2"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:alpha="0.7"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/galaxySearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_apps"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_3"
                    android:textSize="15sp" />
            </LinearLayout>

            <com.alfa.launcher.OrbitStage
                android:id="@+id/galaxyStage"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.alfa.launcher.GalaxyView
                    android:id="@+id/galaxyView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/galaxyReset"
                    style="@style/Tech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/glass_pill"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="⟲ RESET VIEW"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </com.alfa.launcher.OrbitStage>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/galaxyPrev"
                    style="@style/Label"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:background="@drawable/glass_pill"
                    android:gravity="center"
                    android:text="‹"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/galaxyPage"
                    style="@style/Tech"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.2" />

                <TextView
                    android:id="@+id/galaxyNext"
                    style="@style/Label"
                    android:layout_width="56dp"
                    android:layout_height="44dp"
                    android:background="@drawable/glass_pill"
                    android:gravity="center"
                    android:text="›"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/menuAnchor"
        android:layout_width="1dp"
        android:layout_height="1dp" />
</com.alfa.launcher.SwipeLayout>
